# ========================================================
# MailGuard — Environment Variables Configuration Template
# Copy this file to .env and adjust as necessary for deployment.
# ========================================================

# Serving Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=info

# Model & Storage Paths
MODEL_PATH=models/spam_pipeline.joblib
METADATA_PATH=models/model_metadata.json
PARAMS_PATH=params.yaml

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=file:///app/mlruns
MLFLOW_EXPERIMENT_NAME=Spam_Email_Detection_System
MLFLOW_ALLOW_FILE_STORE=true

# Monitoring & Auditing
MONITORING_LOG_PATH=data/monitoring/prediction_logs.jsonl
DRIFT_REPORT_HTML=reports/monitoring/data_drift_report.html
DRIFT_METRICS_JSON=reports/monitoring/drift_metrics.json

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

